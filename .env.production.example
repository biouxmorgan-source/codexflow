# Modèle de .env pour le serveur de production (Forge : site → Environment).
# Aucune valeur secrète ici : chaque « à remplir » se saisit sur le serveur, jamais dans le dépôt
# ni dans une discussion. Guide : docs/mise-en-ligne.md. Vérification : php artisan loremundi:check.

APP_NAME=LoreMundi
APP_ENV=production
# Généré une seule fois (php artisan key:generate). Ne jamais le changer ensuite :
# les clés IA enregistrées par les joueurs deviendraient illisibles.
APP_KEY=
APP_DEBUG=false
APP_URL=https://loremundi.example

APP_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Un fichier de journal par jour, sans les détails de débogage.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Base créée par Forge à la création du serveur (PostgreSQL 16).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=loremundi
DB_USERNAME=forge
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# E-mails (Brevo, offre gratuite) : identifiants SMTP de Brevo → SMTP & API.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="bonjour@loremundi.example"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Temps réel : Forge remplit ces valeurs en activant Reverb (site → Application → Laravel Reverb).
# Reverb écoute en interne sur le port 8080 ; le public passe par HTTPS sur le port 443.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="loremundi.example"
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Notifications push : php artisan webpush:vapid --show, une seule fois, puis coller ici.
# Changer ces clés désabonne tous les appareils.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Paiements (plus tard, une fois l'entreprise et le compte Stripe créés).
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# Mentions légales (page « Confidentialité et mentions légales »).
LEGAL_OWNER=
LEGAL_SIRET=
LEGAL_ADDRESS=
LEGAL_EMAIL=
LEGAL_HOST="Hetzner Online GmbH, Industriestr. 25, 91710 Gunzenhausen, Allemagne"

# Sauvegarde de nuit (03 h 30) de la base et des fichiers, gardée 7 jours sur le serveur.
# Une copie hors du serveur reste indispensable : voir le guide.
BACKUP_ENABLED=true
BACKUP_PATH=/home/forge/backups/loremundi
BACKUP_KEEP_DAYS=7
